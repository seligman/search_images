  "max_edge": "resize to this many pixels on the long edge (JPEG quality 92), keeping the metadata",
  "exif_date": "write as EXIF DateTimeOriginal (the source page's date)",
  "exif_offset": "write as EXIF OffsetTimeOriginal",
  "gps": "write as EXIF GPS: lat, lon (WGS-84) and accuracy_m as GPSHPositioningError",
  "remove_gps_void": "remove EXIF GPSStatus (V, void: the camera had no position)",
  "xmp_place": "write these names in the XMP location fields (photoshop:City, photoshop:State, photoshop:Country, Iptc4xmpCore:CountryCode), in place of what those fields held; no position is added",
  "transcode": "make a 720p H.264 / AAC MP4 copy of the video with ffmpeg",
  "video_date": "write as the copy's QuickTime creation date",
